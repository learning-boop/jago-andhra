# Jago Andhra — Apache / cPanel hosting (copied into public_html by the build)
Options -MultiViews -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Uncomment to force HTTPS once the SSL certificate is active:
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Real files and folders (assets, PDFs, photos, the /api backend) are served as they are
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^api/ - [L]

  # Every other address (/issue, /gallery, /admin, /updates/…) is a page of the React app
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Built JS/CSS have hashed names, so they can be cached for a long time
  <FilesMatch "\.(js|css|webp|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
